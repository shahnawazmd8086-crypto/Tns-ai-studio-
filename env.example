# TNS Studio production environment template. Never commit real values.
NODE_ENV=production
PORT=3000
SESSION_TIMEOUT_MINUTES=1440
API_RATE_LIMIT=120
OTP_EXPOSE_CODE=false

# Real AI provider adapter. The built-in `http` provider expects JSON endpoints.
VIDEO_PROVIDER=http
IMAGE_PROVIDER=http
VOICE_PROVIDER=http
TNS_VIDEO_PROVIDER_URL=
TNS_IMAGE_PROVIDER_URL=
TNS_VOICE_PROVIDER_URL=
TNS_AI_PROVIDER_API_KEY=
TNS_AI_PROVIDER_TIMEOUT_MS=120000

# Production media/editor
FFMPEG_PATH=ffmpeg

# Real production services still to be connected:
# - persistent database / DATABASE_URL
# - email/SMS OTP provider credentials
# - Google OAuth client ID/secret + callback URL
# - object storage credentials/bucket
# - push notification credentials
# - WebRTC signaling/STUN/TURN credentials
# - payment/ads credentials

TNS_DATA_ENCRYPTION_KEY=
